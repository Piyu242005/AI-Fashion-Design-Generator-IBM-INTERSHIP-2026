{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/design",  "destination": "/api/design.py"  },
    { "source": "/api/health",  "destination": "/api/health.py"  },
    { "source": "/(.*)",        "destination": "/index.html"     }
  ]
}
