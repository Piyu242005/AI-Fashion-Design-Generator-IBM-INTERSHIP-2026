{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.py": {
      "runtime": "python3.9"
    }
  },
  "routes": [
    { "src": "/api/design", "dest": "/api/design.py" },
    { "src": "/api/health", "dest": "/api/health.py" },
    { "src": "/(.*)",        "dest": "/index.html"   }
  ]
}
