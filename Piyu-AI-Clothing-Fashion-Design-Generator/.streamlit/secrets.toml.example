# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to source control (.gitignore excludes it).
#
# Streamlit Cloud: paste these values in the "Secrets" panel of your app
# settings at https://share.streamlit.io instead of using a file.
# ─────────────────────────────────────────────────────────────────────────

# Hugging Face access token
# Required if your HF model repository is private or access-gated.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
