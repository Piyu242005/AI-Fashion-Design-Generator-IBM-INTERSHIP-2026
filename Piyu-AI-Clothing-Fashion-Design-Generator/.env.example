# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Hugging Face access token
# Required if your model repository (HF_REPO_ID) is private or access-gated.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Hugging Face model repository ID
# Default: Piyu242005/piyu-fashion-models
# Override if you fork the model repository.
HF_REPO_ID=Piyu242005/piyu-fashion-models

# Local directory where model weights are cached after download
# Default: models/
MODEL_DIR=models
