# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Hugging Face access token ────────────────────────────────────────────
# Required if your model repository is private or access-gated.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ── Hugging Face model repository ID ────────────────────────────────────
# Default: Piyu2420/AI-Fashion-Design-Generator-IBM-INTERSHIP-2026
# Override only if you fork the model repository.
HF_REPO_ID=Piyu2420/AI-Fashion-Design-Generator-IBM-INTERSHIP-2026

# ── Local weight cache root ──────────────────────────────────────────────
# Default: project root (weights/ and idm_vton/ckpt/ are created here)
MODEL_DIR=.
