# ── Python artifacts ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────
.venv/
.venv311/
venv/
env/
ENV/

# ── Model weights (large — stored on Hugging Face / mounted as volumes) ───
*.safetensors
*.pth
*.onnx
*.pkl
*.bin
weights/
models/
idm_vton/ckpt/
torch_cache/
hf_cache/

# ── IDM-VTON clone (mounted or cloned inside container) ───────────────────
idm_vton/

# ── Secrets & environment ─────────────────────────────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ── Generated outputs (use host-mounted volume instead) ───────────────────
results/
reference_images/*.png
reference_images/*.jpg

# ── Git ───────────────────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ── Editor / OS ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Logs & temp files ─────────────────────────────────────────────────────
*.log
*.tmp
*.temp
tmp/
temp/

# ── Jupyter ───────────────────────────────────────────────────────────────
*.ipynb
.ipynb_checkpoints/

# ── Documentation (not needed in container) ───────────────────────────────
*.md
*.pdf
*.html
*.gif
*.webp

# ── Docker files themselves (prevents recursive COPY) ─────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore
