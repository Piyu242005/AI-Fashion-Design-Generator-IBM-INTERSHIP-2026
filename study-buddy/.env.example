# ===========================================================================
# AI-Powered Study Buddy — Environment Variables Template
# ===========================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ────────────────────────────────────────────────────────────
APP_NAME="AI-Powered Study Buddy"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# ── Security — REQUIRED ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Google Gemini API — REQUIRED ──────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Gemini model selection
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=2048

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/study_buddy.db
SYNC_DATABASE_URL=sqlite:///./data/study_buddy.db

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=study_buddy_docs

# ── Embeddings ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── File Upload ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── RAG Configuration ──────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RAG_TOP_K=5

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ── CORS — Update for your frontend URL ───────────────────────────────────
# ALLOWED_ORIGINS=["http://localhost:8501","https://your-app.streamlit.app"]

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend — points to backend ──────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
