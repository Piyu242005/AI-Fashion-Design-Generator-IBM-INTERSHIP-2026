# ===========================================================================
# AI-Powered Study Buddy — Next.js Frontend Environment Variables
# ===========================================================================
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── FastAPI Backend URL ─────────────────────────────────────────────────────
# Local development (default — proxied by next.config.ts rewrites)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production — replace with your Render deployment URL
# NEXT_PUBLIC_API_URL=https://ai-study-buddy.onrender.com

# ── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
