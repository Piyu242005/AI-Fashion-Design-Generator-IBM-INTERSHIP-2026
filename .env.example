# ==============================================================
# AI Fashion Studio — Environment Variables
# ==============================================================
# Copy this file to .env and fill in your keys.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env  (Windows)
#
# NEVER commit .env to git. Only .env.example is safe to commit.
#
# Architecture: Vercel-only (React frontend + Python serverless API)
# Local dev:    vercel dev  (mirrors production exactly)
# ==============================================================


# --------------------------------------------------------------
# SERVER-SIDE — Cloudflare Workers AI  (image generation)
# --------------------------------------------------------------
# 1. Sign up at https://dash.cloudflare.com
# 2. Enable Workers AI: AI > Workers AI > Enable
# 3. Account ID: right sidebar of any Cloudflare dashboard page
# 4. API token: My Profile > API Tokens > Create Token
#    Permissions: Workers AI — Read, Workers AI — Edit
#
# Used by: api/design.py  →  POST /api/design
# NEVER prefix with VITE_ — must stay server-side only.
#
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token


# --------------------------------------------------------------
# BROWSER-VISIBLE — Google Gemini  (fashion spec extraction)
# --------------------------------------------------------------
# Get your key at https://aistudio.google.com/app/apikey
# Free tier covers gemini-2.5-flash text generation.
# This key is included in the browser bundle — use a free-tier
# key with limited scope only.
#
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.5-flash


# --------------------------------------------------------------
# SERVER-SIDE — Hugging Face  (IDM-VTON virtual try-on)
# --------------------------------------------------------------
# Space: https://huggingface.co/spaces/yisol/IDM-VTON
# License: CC BY-NC-SA 4.0 (non-commercial use only)
#
# 1. Sign up at https://huggingface.co
# 2. Go to https://huggingface.co/settings/tokens
# 3. Create a READ token and paste it below.
#
# Used by: api/try-on.py  →  POST /api/try-on
# NEVER prefix with VITE_ — must stay server-side only.
#
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_SPACE_ID=yisol/IDM-VTON


# --------------------------------------------------------------
# SERVER-SIDE — RapidAPI H&M  (product recommendations)
# --------------------------------------------------------------
# 1. Sign up at https://rapidapi.com
# 2. Subscribe to "H&M Store" API (free tier available)
# 3. Copy your RapidAPI key below.
#
# Used by: api/products.py  →  GET /api/products/search
# NEVER prefix with VITE_ — must stay server-side only.
#
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=apidojo-hm-hennes-mauritz-v1.p.rapidapi.com
