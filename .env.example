# ==============================================================
# AI Fashion Studio -- Environment Variables
# ==============================================================
# Copy this file to .env and fill in your keys.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env  (Windows)
#
# NEVER commit .env to git. Only .env.example is safe to commit.
# ==============================================================


# --------------------------------------------------------------
# PRIMARY: Cloudflare Workers AI  (FLUX.1-schnell image gen)
# --------------------------------------------------------------
# 1. Sign up at https://dash.cloudflare.com
# 2. Enable Workers AI under AI > Workers AI
# 3. Get your Account ID from the right sidebar of the dashboard
# 4. Create an API token: My Profile > API Tokens
#    Required permissions: Workers AI -- Read, Workers AI -- Edit
#
# Used by: FastAPI backend  ->  POST /api/design
# Token is NEVER sent to the browser.
#
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token


# --------------------------------------------------------------
# SECONDARY: Google Gemini  (free-tier text extraction)
# --------------------------------------------------------------
# Get your key at https://aistudio.google.com/app/apikey
# Free tier covers: gemini-2.5-flash text generation
# NOT free: imagen-4.0 image generation (use Cloudflare instead)
# Used by: React frontend (FashionIntelligenceService)
#
# Vite exposes only VITE_* variables to the browser.
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.5-flash


# --------------------------------------------------------------
# HuggingFace — IDM-VTON Virtual Try-On
# --------------------------------------------------------------
# Space  : https://huggingface.co/spaces/yisol/IDM-VTON
# License: CC BY-NC-SA 4.0 (non-commercial)
#
# 1. Sign up at https://huggingface.co
# 2. Go to https://huggingface.co/settings/tokens
# 3. Create a token with READ permission
# 4. Paste it below — NEVER prefix with VITE_ (must stay server-side)
#
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_SPACE_ID=yisol/IDM-VTON


# --------------------------------------------------------------
# Backend server
# --------------------------------------------------------------
BACKEND_PORT=8000

# URL the React frontend uses to reach the backend
VITE_BACKEND_URL=https://ai-fashion-design-generator-ibm.onrender.com
