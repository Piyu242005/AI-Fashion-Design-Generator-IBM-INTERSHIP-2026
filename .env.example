# ============================================================
# AI Fashion Studio — Environment Variables
# ============================================================
# Copy this file to .env and fill in your keys.
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to git.  Only .env.example is safe to commit.
# ============================================================


# ------------------------------------------------------------
# 🥇  HUGGING FACE  (Free $0.10/month credits — best for dev)
# ------------------------------------------------------------
# Get your token at → https://huggingface.co/settings/tokens
# Required scope: "Make calls to the serverless Inference API"
# Used by: FastAPI backend  →  /api/generate-image
#
HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Hugging Face image model to use.
# FLUX.1-schnell is free-tier friendly and very fast.
# Other options:
#   black-forest-labs/FLUX.1-dev          (better quality, slower)
#   stabilityai/stable-diffusion-xl-base-1.0
#   runwayml/stable-diffusion-v1-5
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell


# ------------------------------------------------------------
# 🥈  GOOGLE GEMINI  (Free tier: text + vision, NOT Imagen)
# ------------------------------------------------------------
# Get your key at → https://aistudio.google.com/app/apikey
# Free tier covers: gemini-2.5-flash text generation ✅
# NOT free:         imagen-4.0 image generation ❌ (paid only)
# Used by: React frontend (FashionIntelligenceService)
#
# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini model for fashion spec extraction (text only — free tier)
VITE_GEMINI_MODEL=gemini-2.5-flash


# ------------------------------------------------------------
# 🥉  FAL.AI  (Pay-as-you-go — skip for college project)
# ------------------------------------------------------------
# Get your key at → https://fal.ai/dashboard/keys
# Uncomment when you're ready for production-quality generation.
#
# FAL_API_KEY=your_fal_key_here
# FAL_IMAGE_MODEL=fal-ai/flux/schnell


# ------------------------------------------------------------
# 🔧  BACKEND SERVER  (FastAPI)
# ------------------------------------------------------------
# Port the Python backend listens on (default: 8000)
BACKEND_PORT=8000

# URL the React frontend uses to call the backend.
# For local dev keep this as-is. Change for production deploy.
VITE_BACKEND_URL=http://localhost:8000
